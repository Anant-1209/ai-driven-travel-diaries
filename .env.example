NODE_ENV=development
PORT=3000

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Firebase project ID used to verify Google sign-in tokens (same project as client/src/firebase.js)
FIREBASE_PROJECT_ID=blog-348b3

# Comma-separated list of browser origins allowed to call the API
CLIENT_URL=http://localhost:5173

# Public site address used in WhatsApp/social link previews, e.g. https://traveldiaries.in
PUBLIC_URL=

# AI providers (at least one required for AI features)
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
