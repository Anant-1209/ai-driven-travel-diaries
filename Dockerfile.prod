# The backend serves trip and destination pages itself so it can add link-preview tags.
FROM node:22-alpine AS client

WORKDIR /usr/src/client

COPY client/package*.json ./
RUN npm ci

COPY client/ ./
RUN npm run build

FROM node:22-alpine

WORKDIR /usr/src/app

COPY package*.json ./

RUN npm ci --omit=dev

COPY . .
COPY --from=client /usr/src/client/dist ./client/dist

RUN mkdir -p uploads && chown -R node:node uploads

ENV NODE_ENV=production

USER node

EXPOSE 3000

CMD ["node", "index.js"]
